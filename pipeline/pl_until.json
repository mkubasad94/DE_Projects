{
	"name": "pl_until",
	"properties": {
		"activities": [
			{
				"name": "Until",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@variables('until_var')",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Lookup_refresh_column",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Lookup_refresh_column').output.firstRow.RefreshStatus,true)\n",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Set RefreshStatus",
										"type": "SetVariable",
										"dependsOn": [],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "until_var",
											"value": true
										}
									}
								]
							}
						},
						{
							"name": "Lookup_refresh_column",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT RefreshStatus FROM TableRereshStatus WHERE TableName = 'employees'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_lookup_sql_table",
									"type": "DatasetReference"
								},
								"firstRowOnly": true
							}
						}
					],
					"timeout": "00:05:00"
				}
			}
		],
		"variables": {
			"until_var": {
				"type": "Boolean",
				"defaultValue": false
			}
		},
		"folder": {
			"name": "until_wait"
		},
		"annotations": []
	}
}
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@equals(activity('Lookup_refresh_column').output.firstRow.RefreshStatus,true)\n",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{

{
	"name": "pl_copy_web data_with_rest_api_connector",
	"properties": {
		"activities": [
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Web activity for pagecount",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(1,activity('Web activity for pagecount').output.total_pages)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy web data with rest api",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.010",
									"requestMethod": "GET",
									"additionalHeaders": {
										"x-api-key": "reqres-free-v1"
									},
									"paginationRules": {
										"supportRFC5988": "true"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "id"
											}
										},
										{
											"source": {
												"path": "email"
											}
										},
										{
											"source": {
												"path": "first_name"
											}
										},
										{
											"source": {
												"path": "last_name"
											}
										},
										{
											"source": {
												"path": "$['data'][0]['avatar']"
											}
										},
										{
											"source": {
												"path": "$['support']['url']"
											}
										},
										{
											"source": {
												"path": "$['support']['text']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['powered_by']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['upgrade_url']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['docs_url']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['template_gallery']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['message']"
											}
										},
										{
											"source": {
												"path": "$['_meta']['features'][0]"
											}
										},
										{
											"source": {
												"path": "$['_meta']['upgrade_cta']"
											}
										}
									],
									"collectionReference": "",
									"mapComplexValuesToString": false
								}
							},
							"inputs": [
								{
									"referenceName": "ds_rest_api",
									"type": "DatasetReference",
									"parameters": {
										"page_num": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_target_rest_api_copy_web_data",
									"type": "DatasetReference",
									"parameters": {
										"pagename": {
											"value": "target_page_name_@{item()}",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Web activity for pagecount",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"x-api-key": "reqres-free-v1"
					},
					"url": "https://reqres.in/api/users?page=1"
				}
			}
		],
		"folder": {
			"name": "Validation_Script_N_WebActivity_rest_api"
		},
		"annotations": []
	}
}
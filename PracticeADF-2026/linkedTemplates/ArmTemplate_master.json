{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "PracticeADF-2026"
		},
		"ls_sql_server_incremental_load_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_server_incremental_load'"
		},
		"ls_target_increamental_load_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_target_increamental_load'"
		},
		"KV_Storage_Access_key_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kvdeproject.vault.azure.net/"
		},
		"ls_adls_gen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen22026.dfs.core.windows.net"
		},
		"ls_sql_server_incremental_load_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "az-sql-server-2025.database.windows.net"
		},
		"ls_sql_server_incremental_load_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "source"
		},
		"ls_sql_server_incremental_load_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mkubasad"
		},
		"ls_target_increamental_load_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "az-sql-server-2025.database.windows.net"
		},
		"ls_target_increamental_load_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "target"
		},
		"ls_target_increamental_load_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "mkubasad"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "PracticeADF-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_sql_server_incremental_load_password": {
						"value": "[parameters('ls_sql_server_incremental_load_password')]"
					},
					"ls_target_increamental_load_password": {
						"value": "[parameters('ls_target_increamental_load_password')]"
					},
					"KV_Storage_Access_key_properties_typeProperties_baseUrl": {
						"value": "[parameters('KV_Storage_Access_key_properties_typeProperties_baseUrl')]"
					},
					"ls_sql_server_incremental_load_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_server_incremental_load_properties_typeProperties_server')]"
					},
					"ls_sql_server_incremental_load_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_server_incremental_load_properties_typeProperties_database')]"
					},
					"ls_sql_server_incremental_load_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_server_incremental_load_properties_typeProperties_userName')]"
					},
					"ls_target_increamental_load_properties_typeProperties_server": {
						"value": "[parameters('ls_target_increamental_load_properties_typeProperties_server')]"
					},
					"ls_target_increamental_load_properties_typeProperties_database": {
						"value": "[parameters('ls_target_increamental_load_properties_typeProperties_database')]"
					},
					"ls_target_increamental_load_properties_typeProperties_userName": {
						"value": "[parameters('ls_target_increamental_load_properties_typeProperties_userName')]"
					},
					"ls_adls_gen2_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_gen2_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "PracticeADF-2026_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'PracticeADF-2026_ArmTemplate_0')]"
			]
		}
	]
}